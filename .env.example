# =============================
# YEREL GELİŞTİRME (mevcut)
# =============================
DATABASE_URL="file:./dev.db"
NEXT_PUBLIC_SITE_URL="http://localhost:3000"
ADMIN_PASSWORD="degistirin"
ADMIN_SECRET="rastgele-uzun-string-buraya"

# =============================
# CANLIDA EKLENECEK (Vercel)
# =============================
# NEXT_PUBLIC_SITE_URL="https://ebruca.com"

# Turso (SQLite cloud)
# Canlı bilgiler bu dosyada DEĞİL, .env.production.local içinde tutulur
# (git dışında). Böylece yerel geliştirme yanlışlıkla canlıya bağlanmaz.
# DATABASE_URL="libsql://<dbadi>-<kullanici>.turso.io"
# TURSO_AUTH_TOKEN="eyJhbGc..."
#
# ŞEMA GÜNCELLEMESİ: `prisma db push` canlıya UYGULANMAZ — prisma.config.ts
# datasource URL'ini sabit olarak yerel dev.db'ye yazar. Canlı şema değişikliği
# için prisma/manual/ altındaki SQL script'leri kullanılır.

# Cloudinary (Görsel)
# STORAGE_PROVIDER="cloudinary"
# CLOUDINARY_CLOUD_NAME="ebruca"
# CLOUDINARY_API_KEY="123456789012345"
# CLOUDINARY_API_SECRET="abc123..."

# Vercel Cron — ödenmemiş siparişleri 72 saat sonra iptal eden görev
# (vercel.json içinde tanımlı). Bu değişken Vercel'de tanımlıysa, Vercel
# isteği "Authorization: Bearer <CRON_SECRET>" başlığıyla gönderir ve
# uç nokta dışarıdan tetiklenemez. Rastgele uzun bir string olmalı.
# CRON_SECRET="rastgele-uzun-string"

# Google / Bing site doğrulama (opsiyonel)
# GOOGLE_SITE_VERIFICATION="..."
