generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "sqlite"
}

model Product {
  id            String      @id @default(cuid())
  slug          String      @unique
  name          String
  brand         String      @default("Ebruca")
  code          String
  price         Float
  originalPrice Float?
  images        String      @default("[]")
  category      String
  subcategory   String?
  sizes         String      @default("[]")
  colors        String      @default("[]")
  description   String      @default("")
  measurements  String?
  stock         String      @default("in_stock")
  sizeStock     String      @default("{}")
  colorImages   String      @default("{}")
  colorSizes    String      @default("{}")
  colorSizeStock String     @default("{}")
  isNew         Boolean     @default(true)
  isBestseller  Boolean     @default(false)
  isFeatured    Boolean     @default(false)
  createdAt     DateTime    @default(now())
  updatedAt     DateTime    @updatedAt
}

model User {
  id            String      @id @default(cuid())
  // Daima küçük harfe normalize edilerek saklanır (SQLite unique büyük/küçük harf duyarlıdır)
  email         String      @unique
  passwordHash  String

  firstName     String
  lastName      String
  phone         String      @default("")

  // Kayıtlı teslimat adresi — ödeme formunu ön doldurmak için
  address       String      @default("")
  city          String      @default("")
  district      String      @default("")
  postalCode    String      @default("")

  // Yasal onaylar (KVKK / üyelik sözleşmesi) — kayıt anında damgalanır
  kvkkAcceptedAt  DateTime?
  termsAcceptedAt DateTime?

  // Kaba kuvvet koruması
  failedLoginCount Int       @default(0)
  lockedUntil      DateTime?

  sessions      Session[]
  resetTokens   PasswordResetToken[]
  orders        Order[]

  createdAt     DateTime    @default(now())
  updatedAt     DateTime    @updatedAt
}

model Session {
  id        String   @id @default(cuid())
  // Çerezdeki ham token değil, SHA-256 özeti saklanır
  tokenHash String   @unique
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  expiresAt DateTime
  createdAt DateTime @default(now())

  @@index([userId])
  @@index([expiresAt])
}

model PasswordResetToken {
  id        String    @id @default(cuid())
  tokenHash String    @unique
  userId    String
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime  @default(now())

  @@index([userId])
}

model Order {
  id            String      @id @default(cuid())
  orderNo       String      @unique
  // Durum: pending | confirmed | shipped | delivered | cancelled
  status        String      @default("pending")

  // Üyelik — misafir siparişlerinde null kalır
  userId        String?
  user          User?       @relation(fields: [userId], references: [id], onDelete: SetNull)

  // Müşteri
  firstName     String
  lastName      String
  email         String
  phone         String

  // Teslimat adresi
  address       String
  city          String
  district      String
  postalCode    String      @default("")

  // Finansal
  subtotal      Float
  shippingFee   Float       @default(0)
  total         Float

  // Kargo
  cargoCompany  String      @default("")
  trackingNo    String      @default("")

  // Not
  note          String      @default("")

  // Iyzico ödeme bilgileri
  paymentId             String   @default("")
  paymentToken          String   @default("")
  conversationId        String   @default("")
  basketId              String   @default("")
  paymentTransactionId  String   @default("")
  fraudStatus           Int      @default(0)
  paymentStatus         String   @default("pending")

  items         OrderItem[]
  createdAt     DateTime    @default(now())
  updatedAt     DateTime    @updatedAt

  @@index([userId])
  @@index([email])
}

model OrderItem {
  id          String  @id @default(cuid())
  orderId     String
  order       Order   @relation(fields: [orderId], references: [id], onDelete: Cascade)
  productId   String  @default("")
  name        String
  code        String  @default("")
  price       Float
  size        String
  color       String
  quantity    Int
  image       String  @default("")
}
